{
  "manifest_version": 3,
  "name": "mistri Shield",
  "version": "1.2.0",
  "description": "Blocks ads, trackers, malware and scam sites, and pop-ups. Auto-rejects optional cookies. Built on open-source lists.",
  "minimum_chrome_version": "121",
  "permissions": [
    "declarativeNetRequest",
    "scripting",
    "storage",
    "unlimitedStorage",
    "alarms",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "base",
        "enabled": true,
        "path": "rules/base.json"
      }
    ]
  },
  "action": {
    "default_title": "mistri Shield",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.js",
        "popup.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "homepage_url": "https://github.com/GITAV-LLC/mistri"
}
